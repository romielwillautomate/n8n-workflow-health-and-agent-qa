# Every setting the three workflows read. Placeholders only. Self-hosted n8n must allow $env access in nodes.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# ---------------------------------------------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------------------------------------------
# Slack incoming webhook for error alerts, heartbeat alerts and QA scorecards (Slack > Apps > Incoming WebHooks).
# Required for the error alerts and the heartbeat. The QA harness skips Slack when it is empty.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Time zone for the times in Slack messages (default UTC)
TIMEZONE=America/New_York
# Your n8n address as people open it in a browser, for links in alerts. Without it, error alerts use the link n8n builds
# from its WEBHOOK_URL, and the heartbeat uses N8N_API_URL without /api/v1
N8N_EDITOR_URL=https://n8n.example.com

# ---------------------------------------------------------------------------------------------------------------
# Error alerts (workflow/error-alerts.json)
# ---------------------------------------------------------------------------------------------------------------
# The same workflow, node and message within this many minutes is counted, not posted again (default 30, 0 = post all)
ALERT_REPEAT_WINDOW_MINUTES=30

# ---------------------------------------------------------------------------------------------------------------
# Heartbeat (workflow/workflow-heartbeat.json)
# ---------------------------------------------------------------------------------------------------------------
# The n8n public API of the instance to watch. From inside the n8n container, http://localhost:5678/api/v1 works.
N8N_API_URL=http://localhost:5678/api/v1
# n8n > Settings > n8n API > Create an API key
N8N_API_KEY=your-n8n-api-key
# The workflows to watch, as JSON, and/or a Google Sheet (both are used when both are set). Fields:
# workflow_id (required), label, max_silence_minutes, min_success_rate (percent), expect_active (default true)
WATCHLIST_JSON=[{"workflow_id": "AbCdEf1234567890", "label": "Order sync", "max_silence_minutes": 60, "min_success_rate": 90}]
# Optional Google Sheet: the ID from the sheet URL, and the tab and cells. Share the sheet as "Anyone with the link: Viewer".
WATCHLIST_SHEET_ID=
WATCHLIST_SHEET_RANGE=Watchlist!A1:F500
# Google Cloud API key with the Google Sheets API enabled (only needed for the sheets)
GOOGLE_SHEETS_API_KEY=
# How many recent runs to judge the failure rate on, the fewest runs before it is judged, and how far back to look
HEARTBEAT_SAMPLE_SIZE=20
HEARTBEAT_MIN_RUNS=5
HEARTBEAT_RATE_HOURS=24
# Secret for the Check Now webhook, sent as "Authorization: Bearer <secret>". Empty refuses every Check Now call.
HEARTBEAT_SECRET=make-up-a-long-random-string
# Optional: a URL pinged after every good check (for example a healthchecks.io check), so you hear when the heartbeat itself stops
HEARTBEAT_PING_URL=

# ---------------------------------------------------------------------------------------------------------------
# Agent QA harness (workflow/agent-qa-harness.json)
# ---------------------------------------------------------------------------------------------------------------
# Secret for the Run QA webhook, sent as "Authorization: Bearer <secret>". Empty refuses every call.
QA_RUN_SECRET=make-up-another-long-random-string
# The agent to test: its webhook URL, any headers it needs, and the request body with {{message}} and {{session_id}}
AGENT_URL=https://n8n.example.com/webhook/support-agent
AGENT_HEADERS_JSON={"X-Agent-Secret": "your-agent-secret"}
AGENT_REQUEST_TEMPLATE={"message": "{{message}}", "sessionId": "{{session_id}}"}
# Where the reply text and the tool calls are in the agent's JSON answer. Empty means: look at the usual fields.
AGENT_REPLY_PATH=
AGENT_TOOLS_PATH=
# Seconds to wait for each answer (1 to 60) and tries per case (1 to 3)
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_TRIES=3
# Claude grades the rubrics (console.anthropic.com > API keys). Default model claude-haiku-4-5.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5
# Ready needs at least this pass rate in percent, every case graded and no failed critical case (default 90)
QA_PASS_THRESHOLD=90
# Suite name when neither the request nor the cases file names one (runs are compared per suite)
QA_SUITE_NAME=default
QA_MAX_CASES=50
# true: a reply that addresses a grader ("ignore the rubric", "mark this as pass") fails its case
QA_INJECTION_CHECK=true
# Optional: where to load the cases from when the request body has none (for example the raw URL of qa/test-cases.json)
QA_CASES_URL=
# Optional Google Sheet with more cases (uses GOOGLE_SHEETS_API_KEY above)
QA_SHEET_ID=
QA_SHEET_RANGE=Cases!A1:J500
